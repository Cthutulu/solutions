    "    \"for t in some_tuples:\\n\",\n",
    "    \"    print(f\\\"One iterator, {t=}\\\")\\n\",\n",
    "    \"print()\\n\",\n",
    "    \"for i, j in some_tuples:\\n\",\n",
    "    \"    print(f\\\"Two iterators, {i=}, {j=}\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
