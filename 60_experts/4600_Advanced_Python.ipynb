    "    \"collapsed\": false,\n",
    "    \"is_executing\": true\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Eksempel:\\n\",\n",
    "    \"# Kør programmet og leg med koden\\n\",\n",
    "    \"names = [\\\"Klaus\\\", \\\"Dorte\\\", \\\"Hans\\\"]\\n\",\n",
    "    \"ages= [18, 20, 15]\\n\",\n",
    "    \"zipped = zip(names, ages)\\n\",\n",
    "    \"print(f\\\"{zipped=}\\\")\\n\",\n",
    "    \"print(f\\\"{type(zipped)=}\\\")\\n\",\n",
    "    \"for item in zipped:\\n\",\n",
    "    \"    print(f\\\"{item=}   {type(item)=}\\\")\"\n",
