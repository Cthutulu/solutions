    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Opgave:\\n\",\n",
    "    \"# Tilføj en magisk funktion til klassen Dog så \\\"huge_dog > tiny_dog\\\" interpreteres på en fornuftig måde.\\n\",\n",
    "    \"\\n\",\n",
    "    \"class Dog:\\n\",\n",
    "    \"    def __init__(self, size):\\n\",\n",
    "    \"        self.size = size\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __gt__(self, other):\\n\",\n",
    "    \"        return self.size > other.size\\n\",\n",
